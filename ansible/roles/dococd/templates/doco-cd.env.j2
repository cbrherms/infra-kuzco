DOCO_CD_VERSION={{ doco_cd_version }}
LOG_LEVEL=info
POLL_CONFIG=[{url: {{ infra_repo_url }}, reference: {{ infra_repo_branch }}, interval: {{ doco_cd_poll_interval }} }]
PASS_ENV=true
LOCAL_DOMAIN={{ lookup('ansible.builtin.env', 'LOCAL_DOMAIN') | default('', true) }}
TRAEFIK_DOMAIN={{ lookup('ansible.builtin.env', 'TRAEFIK_DOMAIN') | default('', true) }}
ACME_EMAIL={{ lookup('ansible.builtin.env', 'ACME_EMAIL') | default('', true) }}